{
  "manifest_version": 3,
  "name": "AI Image Replacer",
  "version": "2.0",
  "description": "Автоматически находит и заменяет изображения низкого качества",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["tf.min.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["model_tfjs/*"],
      "matches": ["<all_urls>"]
    }
  ]
}